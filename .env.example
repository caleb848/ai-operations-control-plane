# ─── Deployment ──────────────────────────────────────────────────────────────
# local (default on your machine) or portfolio (public demo: simulated only,
# no keys read, no Ollama). Any hosted build is portfolio regardless.
DEPLOYMENT_MODE=local

# ─── Execution mode ──────────────────────────────────────────────────────────
# Paid API calls need BOTH switches. Anything else serves cloud-tier models
# from MockProvider (DEMO mode) and labels the output as simulated.
AI_LIVE_MODE=false
DEFAULT_PROVIDER=mock            # mock | live

# ─── Spend controls (USD) ────────────────────────────────────────────────────
SESSION_BUDGET_USD=2.00          # per session; reset from the Budget page
LIFETIME_BUDGET_USD=10.00        # across all sessions, real spend only
LIVE_MAX_OUTPUT_TOKENS=4000      # hard cap on max_tokens for cloud calls

# ─── Local AI (Ollama) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768             # effective context the router plans against
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_MS=240000
OLLAMA_MAX_OUTPUT_TOKENS=900
OLLAMA_MODELS=                   # optional allowlist, e.g. gemma4:12b-it-qat,qwen3.5:9b

# ─── Cloud providers (server-side only; never sent to the browser) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_TIMEOUT_MS=90000

# Optional. Registered only when key, model AND both prices are set.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_PRICE_PER_MTOK=
OPENAI_OUTPUT_PRICE_PER_MTOK=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INPUT_PRICE_PER_MTOK=
GEMINI_OUTPUT_PRICE_PER_MTOK=

# ─── Data ────────────────────────────────────────────────────────────────────
DATA_DIR=./data                  # SQLite database location
SEED_DEMO_DATA=true              # seed a labeled demo workload on first run

# ─── Portfolio footer (optional, https only) ─────────────────────────────────
PUBLIC_GITHUB_URL=
PUBLIC_LINKEDIN_URL=
